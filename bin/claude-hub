#!/usr/bin/env bash
# Claude Terminal Hub launcher (macOS/Linux)
# Default: launch the real Electron app (electron/main.js manages its own server).
# "claude-hub tab": reuse/start the plain node server and open it in a normal browser tab.
set -uo pipefail

PORT="${CLAUDE_HUB_PORT:-4778}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
URL="http://localhost:$PORT"
MODE="${1:-app}"

is_running() {
  curl -s -m 1 "$URL/health" 2>/dev/null | grep -q 'claude-terminal-hub'
}

launch_electron() {
  local electron_bin="$ROOT/node_modules/.bin/electron"
  if [ ! -x "$electron_bin" ]; then
    echo "[claude-hub] Electron 이 없어 설치합니다 (npm install)…"
    ( cd "$ROOT" && npm install )
  fi
  if [ ! -x "$electron_bin" ]; then
    echo "[claude-hub] Electron 설치 실패. 수동으로 'npm install' 후 다시 실행하세요." >&2
    exit 1
  fi
  echo "[claude-hub] Electron 앱 실행 -> $URL"
  CLAUDE_HUB_PORT="$PORT" "$electron_bin" "$ROOT/electron/main.js" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

if [ "$MODE" != "tab" ]; then
  launch_electron
  exit 0
fi

if is_running; then
  echo "[claude-hub] already running -> reuse port $PORT (tab)"
  open "$URL"
  exit 0
fi

echo "[claude-hub] starting server on port $PORT ..."
export CLAUDE_HUB_PORT="$PORT"
( cd "$ROOT" && nohup node server.js >/dev/null 2>&1 & disown ) 2>/dev/null

ok=0
for _ in $(seq 1 30); do
  sleep 0.5
  if is_running; then ok=1; break; fi
done

if [ "$ok" = "1" ]; then
  echo "[claude-hub] ready -> $URL (tab)"
  open "$URL"
else
  echo "[claude-hub] failed to start. Try manually: node $ROOT/server.js" >&2
  exit 1
fi
